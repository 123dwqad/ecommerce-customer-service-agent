# Use scripts/init_commerce_env.py to create a NEW private configuration file.
COMMERCE_SIGNING_KEY=replace_with_random_secret_at_least_32_characters
COMMERCE_MYSQL_PASSWORD=replace_with_random_hex_password
COMMERCE_MYSQL_ROOT_PASSWORD=replace_with_random_hex_password
COMMERCE_HTTP_PORT=8080
COMMERCE_DEMO_ENABLED=true
COMMERCE_LLM_ENABLED=false
COMMERCE_INTENT_ENABLED=false
COMMERCE_INTENT_MODEL=qwen-plus
COMMERCE_INTENT_TIMEOUT_SECONDS=8
COMMERCE_INTENT_MAX_RETRIES=1
COMMERCE_INTENT_TRUST_ENV=false
# Optional independent key; otherwise uses DASHSCOPE_API_KEY.
COMMERCE_INTENT_API_KEY=
COMMERCE_INTENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
