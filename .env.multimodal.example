# Copy to .env.multimodal and fill in your provider settings. No existing text-model key is reused.
# Speech protocol: POST multipart/form-data, fields model + file; response {"text":"..."}.
# Full endpoint URL, not just the base URL. Provider must accept PCM WAV input.
COMMERCE_SPEECH_ENABLED=false
# multipart (default) or dashscope_asr (Qwen-Audio-3.0-ASR-Flash)
COMMERCE_SPEECH_PROTOCOL=multipart
COMMERCE_SPEECH_URL=
COMMERCE_SPEECH_MODEL=
COMMERCE_SPEECH_API_KEY=

# Vision protocol: POST Chat Completions JSON with messages containing image_url base64 data.
# Full endpoint URL; e.g. https://<provider>/v1/chat/completions
COMMERCE_VISION_ENABLED=false
COMMERCE_VISION_URL=
COMMERCE_VISION_MODEL=
COMMERCE_VISION_API_KEY=

COMMERCE_MEDIA_TIMEOUT_SECONDS=45
